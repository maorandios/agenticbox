# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_EMAIL_DATA_SOURCE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — never expose to the browser / chat / git
SUPABASE_SERVICE_ROLE_KEY=

# Nylas Hosted OAuth (Phase 2A) — fill locally in .env.local
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=
NYLAS_REDIRECT_URI=http://localhost:3000/api/mail/oauth/callback

# Later phases
NYLAS_WEBHOOK_SECRET=
EMAIL_SYNC_LOOKBACK_DAYS=30
# Latest N threads only (not messages). POC default 100; hard-capped server-side at 500.
EMAIL_SYNC_MAX_THREADS=100
EMAIL_SYNC_CONCURRENCY=3
EMAIL_THREADS_PAGE_SIZE=40
CRON_SECRET=
INTERNAL_ADMIN_SECRET=

# Onyx (server-only) — O5D suspended for Feed-first MVP; never use NEXT_PUBLIC_
ONYX_ENABLED=false
ONYX_BASE_URL=https://cloud.onyx.app/api
ONYX_INGESTION_API_KEY=
ONYX_CHAT_API_KEY=
ONYX_PERSONA_ID=0
ONYX_CC_PAIR_ID=
ONYX_TIMEOUT_MS=120000
ONYX_SEARCH_TIMEOUT_MS=30000
ONYX_MAX_RETRIES=3
ONYX_INDEX_MAX_ATTEMPTS=5

# Feed Intelligence (O5A) — server-only; never NEXT_PUBLIC_
FEED_AI_ENABLED=false
# Cross-thread context via Onyx Search — suspended with Onyx (default off)
FEED_CROSS_THREAD_CONTEXT_ENABLED=false
OPENAI_API_KEY=
OPENAI_FEED_MODEL=gpt-5-mini
FEED_AI_TIMEOUT_MS=60000
FEED_PILOT_MAX_THREADS=20
FEED_DAILY_EXTRACTION_LIMIT=100
FEED_MIN_CONFIDENCE=0.80
FEED_MIN_BUSINESS_RELEVANCE=0.85
FEED_EXTRACTION_VERSION=o5a.5
