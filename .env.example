# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_EMAIL_DATA_SOURCE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — never expose to the browser / chat / git
SUPABASE_SERVICE_ROLE_KEY=

# Nylas Hosted OAuth (Phase 2A) — fill locally in .env.local
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=
NYLAS_REDIRECT_URI=http://localhost:3000/api/mail/oauth/callback

# Later phases
NYLAS_WEBHOOK_SECRET=
EMAIL_SYNC_LOOKBACK_DAYS=30
EMAIL_SYNC_MAX_THREADS=500
EMAIL_SYNC_CONCURRENCY=3
EMAIL_THREADS_PAGE_SIZE=40
CRON_SECRET=
INTERNAL_ADMIN_SECRET=

# Onyx (server-only) — never use NEXT_PUBLIC_ for these
ONYX_ENABLED=false
ONYX_BASE_URL=https://cloud.onyx.app/api
ONYX_INGESTION_API_KEY=
ONYX_CHAT_API_KEY=
ONYX_PERSONA_ID=0
ONYX_CC_PAIR_ID=
ONYX_TIMEOUT_MS=60000
ONYX_MAX_RETRIES=3
